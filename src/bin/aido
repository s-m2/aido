#!/usr/bin/env bash
# aido - AI-assisted command generation (OpenAI-compatible backend)
set -euo pipefail

# ──────────────────────────────────────────────
# Load modules
# ──────────────────────────────────────────────
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
LIB_DIR="${SCRIPT_DIR%/bin}/lib"
# shellcheck source=/dev/null
. "${LIB_DIR}/util.sh"
# shellcheck source=/dev/null
. "${LIB_DIR}/context.sh"
# shellcheck source=/dev/null
. "${LIB_DIR}/prompt.sh"
# shellcheck source=/dev/null
. "${LIB_DIR}/llm.sh"
# shellcheck source=/dev/null
. "${LIB_DIR}/ui.sh"

# ──────────────────────────────────────────────
# Configuration
# ──────────────────────────────────────────────
# shellcheck source=/dev/null
. "${LIB_DIR}/config.sh"
# Precedence: env var > config file > built-in default.
# apply_defaults runs AFTER load_config so a config-file value beats the
# built-in default (and an explicit env var beats both).
load_config
apply_defaults
validate_config

# ──────────────────────────────────────────────
# Main
# ──────────────────────────────────────────────
main() {
  if [[ $# -eq 0 ]]; then
    cat <<EOF
Usage: aido "natural language request"

Examples:
  aido "find all .mjs files and replace LLMService with LLMServices"
  aido "show disk usage of the largest directories in the current folder"
  aido "create a python virtualenv and install requests"

Options:
  --config     Edit the user config (~/.config/aido/config.env)
  --dry-run, -n  Generate a command without the interactive loop

Environment variables (override config file):
  AIDO_MODEL          Model name (default: qwen2.5-coder:7b)
  AIDO_BASE_URL       OpenAI-compatible base URL (default: http://localhost:11434/v1)
  OLLAMA_HOST         Legacy: used to derive BASE_URL if set
  AIDO_API_KEY        Optional API key for cloud endpoints
  AIDO_TEMPERATURE    Sampling temperature (default: 0.1)
  EDITOR              Editor for edit/config actions
EOF
    exit 1
  fi

  # Join all arguments into one prompt (allows unquoted multi-word input)
  local user_prompt="$*"

  # Open the user config in $EDITOR (first run creates a template).
  for arg in "$@"; do
    case "$arg" in
      --config|-c)
        ensure_config_template
        info "Editing ${CONFIG_FILE}"
        info "(save and exit to apply your config)"
        ${EDITOR} "$CONFIG_FILE" </dev/tty >/dev/tty
        load_config
        apply_defaults
        validate_config
        info "Config reloaded."
        return 0 ;;
    esac
  done

  # Quick sanity checks
  command -v curl >/dev/null || die "curl is required"
  command -v jq   >/dev/null || die "jq is required"

  # Non-interactive dry run: generate the command and print it, no approval loop.
  for arg in "$@"; do
    case "$arg" in
      -n|--dry-run)
        info "Dry run: generating command with ${MODEL}..."
        cmd=$(call_llm "$user_prompt")
        echo "$cmd"
        exit 0
        ;;
    esac
  done

  interactive_loop "$user_prompt"
}

main "$@"
